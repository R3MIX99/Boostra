        "jsCode": "const chatId = $('Mensaje, usuario y date').first().json.usuario;\nlet extracted;\ntry {\n  const raw = $input.first().json.content[0].text.trim();\n  const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n  extracted = JSON.parse(jsonMatch ? jsonMatch[0] : raw);\n} catch(e) {\n  return [{ json: { chatId, error: 'No pude entender el mensaje. Intenta de nuevo: \"Gasté $150 en comida con débito\"' } }];\n}\nreturn [{ json: { chatId, extracted, ok: true } }];"
